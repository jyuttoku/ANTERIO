# ============================================================
# Slack 設定
# ============================================================

# Bot Token: Slackアプリの "OAuth & Permissions" から取得 (xoxb-...)
SLACK_BOT_TOKEN=xoxb-your-bot-token-here

# App-Level Token: Slackアプリの "Basic Information > App-Level Tokens" から取得 (xapp-...)
# Socket Modeを有効にして "connections:write" スコープで発行
SLACK_APP_TOKEN=xapp-your-app-token-here

# ============================================================
# Box 設定（本番: JWT認証）
# ============================================================

# Box JWT設定ファイルのパス
# Box Developer Console でアプリを作成し、設定JSONをダウンロードして配置
BOX_CONFIG_FILE_PATH=box_config.json

# ============================================================
# Box 設定（テスト用: 開発者トークン）
# ※ 本番では使わないこと（有効期限60分）
# ============================================================

# BOX_DEVELOPER_TOKEN=your-developer-token-here
# BOX_CLIENT_ID=your-box-client-id
# BOX_CLIENT_SECRET=your-box-client-secret

# ============================================================
# Excel ファイル設定
# ============================================================

# 保存先フォルダID（BoxのフォルダURLの末尾の数字）
# ルートフォルダに保存する場合は "0"
BOX_FOLDER_ID=0

# Excelファイル名
BOX_EXCEL_FILE_NAME=引合い情報.xlsx
